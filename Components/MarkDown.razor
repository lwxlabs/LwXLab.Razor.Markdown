@namespace LwXLab
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using System.Text.RegularExpressions
@using LwXLab.Markdown.Options
@using LwXLab.Markdown.Services
@using LwXLab.Markdown.Models
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS

<div id="@_rootId"
     class="lwx-md @Theme @CssClass @(FullScreen ? "lwx-md-fullscreen" : null) @(EffectiveEnableEdit ? "lwx-md-editable" : "lwx-md-readonly")"
     style="height:@Height;width:@Width;min-height:@MinHeight;max-height:@MaxHeight;">
    @if (ShowToolbar)
    {
        <div class="lwx-md-toolbar">
            @if (EffectiveEnableEdit)
            {
                @if (Toolbar is not null)
                {
                    @Toolbar
                }
                else
                {
                    @if (ShowToolBarButtons)
                    {
                        <div class="lwx-md-toolbar-group">
                            @foreach (var button in EffectiveToolbarButtons.Where(x => x.Visible && !HideIcons.Contains(x.Name, StringComparer.OrdinalIgnoreCase)))
                            {
                                <button type="button" class="lwx-md-btn" title="@button.Title" @onclick="() => ToolbarClickAsync(button)">
                                    @if (!string.IsNullOrWhiteSpace(button.IconCssClass))
                                    {
                                        <span class="@button.IconCssClass"></span>
                                    }
                                    else
                                    {
                                        @button.Text
                                    }
                                </button>
                            }
                        </div>
                    }
                }
            }

            <span class="lwx-md-spacer"></span>

            @if (ShowSearchIcon && EnableSearch)
            {
                <button type="button" class="lwx-md-btn" title="Search" @onclick="OnSearchIconClicked">
                    <span class="lwx-md-icon-search">⌕</span>
                </button>
            }

            @if (ShowActionButton)
            {
                <button type="button" class="lwx-md-btn" title="@ActionButtonText" @onclick="OnActionButtonClicked">@ActionButtonText</button>
            }

            @if (AllowPreviewToggle)
            {
                <label class="lwx-md-view-label">
                    <select class="lwx-md-toolbar-select" value="@CurrentViewMode" @onchange="OnViewModeChangedAsync">
                        <option value="edit">@EditText</option>
                        <option value="preview">@PreviewText</option>
                        <option value="split">@SplitViewText</option>
                    </select>
                </label>
            }

            <div class="lwx-md-toolbar-group">
                @if (ShowThemeSelector)
                {
                    <select class="lwx-md-toolbar-select" title="Theme" value="@Theme" @onchange="SetThemeAsync">
                        <option value="dark">Dark</option>
                        <option value="light">Light</option>
                    </select>
                }
                @if (EffectiveViewMode == LwMarkdownViewMode.Split)
                {
                    <select class="lwx-md-toolbar-select" value="@SplitOrientation" @onchange="OnSplitOrientationChangedAsync">
                        <option value="@LwMarkdownSplitOrientation.Vertical">@SplitViewHorizontalText</option>
                        <option value="@LwMarkdownSplitOrientation.Horizontal">@SplitViewVerticalText</option>
                    </select>
                }

                @if (AllowFullScreen)
                {
                    <button type="button" class="lwx-md-btn" title="@(FullScreen ? ExitFullScreenText : FullScreenText)" @onclick="ToggleFullScreen">@(FullScreen ? ExitFullScreenText : FullScreenText)</button>
                }
            </div>
        </div>
    }

    @if (_findVisible && EnableSearch)
    {
        <div class="lwx-md-findbar">
            <input placeholder="Find" @bind="_findText" @bind:event="oninput" @bind:after="RecalculateFindResultsAsync" />
            <button type="button" class="lwx-md-mini-btn" title="Previous" @onclick="FindPreviousAsync">↑</button>
            <button type="button" class="lwx-md-mini-btn" title="Next" @onclick="FindNextAsync">↓</button>
            <label><input type="checkbox" @bind="_findMatchCase" @bind:after="RecalculateFindResultsAsync" /> Aa</label>
            <label><input type="checkbox" @bind="_findWholeWord" @bind:after="RecalculateFindResultsAsync" /> Word</label>
            <label><input type="checkbox" @bind="_findRegex" @bind:after="RecalculateFindResultsAsync" /> .* </label>
            <span class="lwx-md-find-count">@_findStatus</span>
            <button type="button" class="lwx-md-icon-btn" title="Close" @onclick="HideFind">×</button>
        </div>
    }

    <div class="lwx-md-body lwx-md-mode-@EffectiveViewMode.ToString().ToLower() lwx-md-split-@SplitOrientation.ToString().ToLower()">
        @if (EffectiveViewMode != LwMarkdownViewMode.Preview && EffectiveEnableEdit)
        {
            <div class="lwx-md-editor-pane">
                <textarea id="@_editorId"
                          class="lwx-md-textarea"
                          placeholder="@Placeholder"
                          spellcheck="@NativeSpellChecker"
                          readonly="@ReadOnly"
                          value="@Value"
                          @oninput="OnTextAreaInputAsync"></textarea>
            </div>
        }

        @if (EffectiveViewMode == LwMarkdownViewMode.Split)
        {
            <div id="@_resizerId" class="lwx-md-resizer"></div>
        }

        @if (ShowPreviewPane)
        {
            <div id="@_previewId" class="lwx-md-preview @PreviewCssClass">
                @((MarkupString)_html)
            </div>
        }
    </div>

    @if (ShowStatusBar)
    {
        <div class="lwx-md-status">
            @if (ShowCharacters)
            {
                <span>@CharactersStatusText: @_stats.Characters</span>
            }
            @if (ShowWords)
            {
                <span>@WordsStatusText: @_stats.Words</span>
            }
            @if (ShowLines)
            {
                <span>@LinesStatusText: @_stats.Lines</span>
            }
            @if (ShowAiTokens)
            {
                <span>@AiTokensStatusText: @_stats.AiTokens</span>
            }
            @if (AutoSaveEnabled && !string.IsNullOrWhiteSpace(_lastAutoSaveText))
            {
                <span>@_lastAutoSaveText</span>
            }
        </div>
    }
</div>

@code {
    private readonly string _rootId = $"lwx-md-{Guid.NewGuid():N}";
    private readonly string _editorId = $"lwx-md-editor-{Guid.NewGuid():N}";
    private readonly string _previewId = $"lwx-md-preview-{Guid.NewGuid():N}";
    private readonly string _resizerId = $"lwx-md-resizer-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<MarkDown>? _dotNetRef;
    private LwMarkdownRenderer? _renderer;
    private string _html = string.Empty;
    private string _lastRenderedValue = string.Empty;
    private bool _monacoReady;
    private LwMarkdownStats _stats;
    private string? _lastAutoSaveText;
    private CancellationTokenSource? _autoSaveCts;
    private CancellationTokenSource? _valueChangedCts;
    private bool _showSplitOptions;
    private bool _disposed;
    private bool _findVisible;
    private string _findText = string.Empty;
    private bool _findMatchCase;
    private bool _findWholeWord;
    private bool _findRegex;
    private List<int> _findMatches = [];
    private int _findIndex = -1;
    private string _findStatus => string.IsNullOrWhiteSpace(_findText) ? "" : _findMatches.Count == 0 ? "No results" : $"{Math.Max(1, _findIndex + 1)} / {_findMatches.Count}";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? ValueHTML { get; set; }
    [Parameter] public EventCallback<string> ValueHTMLChanged { get; set; }
    [Parameter] public EventCallback<LwMarkdownStats> StatsChanged { get; set; }

    [Parameter] public string Theme { get; set; } = "dark";
    [Parameter] public EventCallback<string> ThemeChanged { get; set; }

    [Parameter] public LwMarkdownViewMode ViewMode { get; set; } = LwMarkdownViewMode.Edit;
    [Parameter] public EventCallback<LwMarkdownViewMode> ViewModeChanged { get; set; }

    [Parameter] public LwMarkdownSplitOrientation SplitOrientation { get; set; } = LwMarkdownSplitOrientation.Vertical;
    [Parameter] public EventCallback<LwMarkdownSplitOrientation> SplitOrientationChanged { get; set; }

    [Parameter] public bool EnableEdit { get; set; } = true;
    [Parameter] public bool EnableMenu { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Preview { get; set; }
    [Parameter] public bool SplitView { get; set; } = true;
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public bool ShowToolBarButtons { get; set; } = true;
    [Parameter] public bool ShowStatusBar { get; set; } = true;
    [Parameter] public bool ShowThemeSelector { get; set; }
    [Parameter] public bool ShowPreviewWhenEditing { get; set; } = true;
    [Parameter] public bool AllowPreviewToggle { get; set; } = true;
    [Parameter] public bool AllowFullScreen { get; set; } = true;
    [Parameter] public bool FullScreen { get; set; }

    [Parameter] public bool EnableMonaco { get; set; } = true;
    [Parameter] public bool EnableMermaid { get; set; } = true;
    [Parameter] public bool EnableHighlight { get; set; } = true;
    [Parameter] public bool EnableHtml { get; set; } = true;
    [Parameter] public bool EnableTables { get; set; } = true;
    [Parameter] public bool EnableTaskLists { get; set; } = true;
    [Parameter] public bool EnableEmoji { get; set; } = true;
    [Parameter] public bool EnableAutoLinks { get; set; } = true;
    [Parameter] public bool EnableAdvancedExtensions { get; set; } = true;
    [Parameter] public bool EnableBootstrap { get; set; }

    [Parameter] public LwMarkdownEditorOptions EditorOptions { get; set; } = new();
    [Parameter] public LwMarkdownOptions? Options { get; set; }

    [Parameter] public string Height { get; set; } = "500px";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string MinHeight { get; set; } = "220px";
    [Parameter] public string MaxHeight { get; set; } = "none";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? PreviewCssClass { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Write markdown...";
    [Parameter] public bool NativeSpellChecker { get; set; }
    [Parameter] public string Direction { get; set; } = "ltr";

    [Parameter] public string[] HideIcons { get; set; } = [];
    [Parameter] public IReadOnlyList<LwMarkdownButton>? ToolbarButtons { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public EventCallback<LwMarkdownButton> CustomButtonClicked { get; set; }

    [Parameter] public bool ShowCharacters { get; set; } = true;
    [Parameter] public bool ShowWords { get; set; } = true;
    [Parameter] public bool ShowLines { get; set; } = true;
    [Parameter] public bool ShowAiTokens { get; set; } = true;
    [Parameter] public string CharactersStatusText { get; set; } = "Characters";
    [Parameter] public string WordsStatusText { get; set; } = "Words";
    [Parameter] public string LinesStatusText { get; set; } = "Lines";
    [Parameter] public string AiTokensStatusText { get; set; } = "AI tokens";

    [Parameter] public bool AutoSaveEnabled { get; set; }
    [Parameter] public string? AutoSaveId { get; set; }
    [Parameter] public int AutoSaveDelay { get; set; } = 700;
    [Parameter] public string AutoSaveText { get; set; } = "Saved";

    [Parameter] public string PreviewText { get; set; } = "👁";
    [Parameter] public string EditText { get; set; } = "✎";
    [Parameter] public string SplitViewText { get; set; } = "◫";
    [Parameter] public string SplitViewHorizontalText { get; set; } = "⇔";
    [Parameter] public string SplitViewVerticalText { get; set; } = "⇕";
    [Parameter] public string FullScreenText { get; set; } = "⛶";
    [Parameter] public string ExitFullScreenText { get; set; } = "❌";

    [Parameter] public bool ShowActionButton { get; set; }
    [Parameter] public EventCallback OnActionButtonClicked { get; set; }
    [Parameter] public string ActionButtonText { get; set; } = "✎";


    [Parameter] public bool ShowSearchIcon { get; set; } = false;
    [Parameter] public bool EnableSearch { get; set; } = false; // shows the search toolbar

    [Parameter] public bool EnableScrollPreview { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool EffectiveEnableEdit => EnableEdit && EnableMenu;

    private LwMarkdownViewMode EffectiveViewMode => Preview
        ? (SplitView ? LwMarkdownViewMode.Split : LwMarkdownViewMode.Preview)
        : ViewMode;

    private string CurrentViewMode => EffectiveViewMode switch
    {
        LwMarkdownViewMode.Preview => "preview",
        LwMarkdownViewMode.Split => "split",
        _ => "edit"
    };

    private bool ShowPreviewPane => !EffectiveEnableEdit || EffectiveViewMode == LwMarkdownViewMode.Preview || EffectiveViewMode == LwMarkdownViewMode.Split;

    private IReadOnlyList<LwMarkdownButton> EffectiveToolbarButtons => ToolbarButtons ?? DefaultButtons;

    private static readonly IReadOnlyList<LwMarkdownButton> DefaultButtons =
    [
        new() { Name = "bold", Text = "B", Title = "Bold", Before = "**", After = "**", Placeholder = "bold text" },
        new() { Name = "italic", Text = "I", Title = "Italic", Before = "*", After = "*", Placeholder = "italic text" },
        new() { Name = "heading", Text = "H", Title = "Heading", Before = "## ", Placeholder = "Heading" },
        new() { Name = "quote", Text = "❝", Title = "Quote", Before = "> ", Placeholder = "quote" },
        new() { Name = "code", Text = "</>", Title = "Code block", Before = "```csharp\n", After = "\n```", Placeholder = "// code" },
        new() { Name = "link", Text = "🔗", Title = "Link", Before = "[", After = "](https://)", Placeholder = "link text" },
        new() { Name = "table", Text = "▦", Title = "Table", Before = "\n| Column | Value |\n|---|---|\n| A | B |" },
        new() { Name = "mermaid", Text = "◇", Title = "Mermaid flow", Before = "\n```mermaid\nflowchart TD\n    A[Start] --> B[End]\n```" },
        new() { Name = "hr", Text = "—", Title = "Horizontal rule", Before = "\n---\n" }
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AutoSaveEnabled && !string.IsNullOrWhiteSpace(AutoSaveId))
        {
            // actual restore is JS-side after first render; this keeps server prerender safe
        }

        RenderMarkdown(notify: false);
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        RenderMarkdown(notify: false);
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("updateOptions", _rootId, _editorId, BuildClientOptions());
            }
            catch (Exception ex) when (ex is JSException or ObjectDisposedException)
            {
                await DisposeModuleAsync();
            }
        }
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LwXLab.Markdown/lwxlab-markdown.js");
                await _module.InvokeVoidAsync("init", _rootId, _editorId, _previewId, _resizerId, _dotNetRef, BuildClientOptions());

                if (AutoSaveEnabled && !string.IsNullOrWhiteSpace(AutoSaveId))
                {
                    var restored = await _module.InvokeAsync<string?>("restoreAutoSave", AutoSaveId);
                    if (!string.IsNullOrEmpty(restored) && string.IsNullOrEmpty(Value))
                        await SetValueAsync(restored, notify: true);
                }

                _monacoReady = EffectiveEnableEdit && EnableMonaco;
            }
            catch (Exception ex) when (ex is JSException or ObjectDisposedException)
            {
                await DisposeModuleAsync();
            }
        }

        if (_module is not null && !_disposed)
        {
            try
            {
                await _module.InvokeVoidAsync("enhancePreview", _previewId, BuildClientOptions());
            }
            catch (Exception ex) when (ex is JSException or ObjectDisposedException)
            {
                await DisposeModuleAsync();
            }
        }
    }

    private object BuildClientOptions()
    {
        var options = CreateOptions();
        return new
        {
            enableMonaco = EffectiveEnableEdit && EnableMonaco,
            enableMermaid = EnableMermaid,
            enableHighlight = EnableHighlight,
            monacoLoaderUrl = options.MonacoLoaderUrl,
            monacoBaseUrl = options.MonacoBaseUrl,
            mermaidUrl = options.MermaidUrl,
            highlightUrl = options.HighlightUrl,
            highlightThemeUrl = options.HighlightThemeUrl,
            theme = Theme,
            viewMode = EffectiveViewMode.ToString().ToLower(),
            splitOrientation = SplitOrientation.ToString().ToLower(),
            autoSaveEnabled = AutoSaveEnabled,
            autoSaveId = AutoSaveId,
            autoSaveDelay = AutoSaveDelay,
            editor = new
            {
                theme = EditorOptions.Theme,
                language = EditorOptions.Language,
                automaticLayout = EditorOptions.AutomaticLayout,
                lineNumbers = EditorOptions.LineNumbers ? "on" : "off",
                wordWrap = EditorOptions.LineWrapping ? "on" : "off",
                minimap = new { enabled = EnableScrollPreview || EditorOptions.Minimap },
                tabSize = EditorOptions.TabSize,
                wordBasedSuggestions = EditorOptions.WordBasedSuggestions ? "allDocuments" : "off",
                formatOnPaste = EditorOptions.FormatOnPaste,
                formatOnType = EditorOptions.FormatOnType,
                renderWhitespace = EditorOptions.RenderWhitespace ? "all" : "none",
                scrollBeyondLastLine = EditorOptions.ScrollBeyondLastLine,
                stickyScroll = new { enabled = EditorOptions.StickyScroll },
                fontFamily = EditorOptions.FontFamily,
                fontSize = EditorOptions.FontSize,
                readOnly = ReadOnly
            }
        };
    }

    private LwMarkdownOptions CreateOptions()
    {
        var global = Services.GetService<LwMarkdownOptions>() ?? new LwMarkdownOptions();
        var options = Options ?? global;

        return new LwMarkdownOptions
        {
            EnableMermaid = EnableMermaid,
            EnableHighlight = EnableHighlight,
            EnableMonaco = EnableMonaco,
            EnableTables = EnableTables,
            EnableTaskLists = EnableTaskLists,
            EnableEmoji = EnableEmoji,
            EnableAutoLinks = EnableAutoLinks,
            EnableAdvancedExtensions = EnableAdvancedExtensions,
            EnableBootstrap = EnableBootstrap,
            EnableHtml = EnableHtml,
            MonacoLoaderUrl = options.MonacoLoaderUrl,
            MonacoBaseUrl = options.MonacoBaseUrl,
            MermaidUrl = options.MermaidUrl,
            HighlightUrl = options.HighlightUrl,
            HighlightThemeUrl = options.HighlightThemeUrl
        };
    }

    private void RenderMarkdown(bool notify)
    {
        var currentValue = Value ?? string.Empty;
        if (_renderer is null || _lastRenderedValue != currentValue)
        {
            _renderer = new LwMarkdownRenderer(CreateOptions());
            _html = _renderer.Render(currentValue);
            ValueHTML = _html;
            _stats = CalculateStats(currentValue);
            _lastRenderedValue = currentValue;
        }
    }

    private async Task OnTextAreaInputAsync(ChangeEventArgs args)
    {
        await SetValueAsync(args.Value?.ToString() ?? string.Empty, notify: true);
    }

    [JSInvokable]
    public async Task UpdateValueFromJs(string value)
    {
        await SetValueAsync(value, notify: true);
    }

    public Task<string> GetValueAsync() => Task.FromResult(Value ?? string.Empty);

    public async Task SetValueAsync(string? value) => await SetValueAsync(value, notify: true);

    private async Task SetValueAsync(string? value, bool notify)
    {
        Value = value ?? string.Empty;
        _lastRenderedValue = string.Empty;
        RenderMarkdown(notify);

        await SafeInvokeVoidAsync("setEditorValue", _editorId, Value);
        await SafeInvokeVoidAsync("enhancePreview", _previewId, BuildClientOptions());

        if (notify)
        {
            await StatsChanged.InvokeAsync(_stats);

            if (AutoSaveEnabled)
            {
                ScheduleValueChanged(Value, _html);
                if (_module is not null && !string.IsNullOrWhiteSpace(AutoSaveId))
                    ScheduleAutoSave(Value);
            }
            else
            {
                await ValueChanged.InvokeAsync(Value);
                await ValueHTMLChanged.InvokeAsync(_html);
            }
        }

        StateHasChanged();
    }

    private async ValueTask DisposeModuleAsync()
    {
        _monacoReady = false;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or ObjectDisposedException)
            {
            }

            _module = null;
        }
    }

    public async Task InsertTextAsync(string text)
    {
        if (_module is not null && _monacoReady)
            await SafeInvokeVoidAsync("insertText", _editorId, text);
        else
            await SetValueAsync((Value ?? string.Empty) + text, notify: true);
    }

    public async Task CleanAutoSave()
    {
        _autoSaveCts?.Cancel();
        if (_module is not null && !string.IsNullOrWhiteSpace(AutoSaveId))
            await SafeInvokeVoidAsync("clearAutoSave", AutoSaveId);
    }

    public async Task TogglePreviewAsync()
    {
        await SetViewMode(EffectiveViewMode == LwMarkdownViewMode.Preview ? LwMarkdownViewMode.Edit : LwMarkdownViewMode.Preview);
        await Task.CompletedTask;
    }

    private async Task SetViewMode(LwMarkdownViewMode mode)
    {
        ViewMode = mode;
        Preview = mode is LwMarkdownViewMode.Preview or LwMarkdownViewMode.Split;
        SplitView = mode == LwMarkdownViewMode.Split;
        _showSplitOptions = false;
        await ViewModeChanged.InvokeAsync(mode);
        StateHasChanged();
        await Task.Delay(50);
        await SafeInvokeVoidAsync("layoutEditor", _editorId);
    }

    private async Task OnViewModeChangedAsync(ChangeEventArgs args)
    {
        var mode = args.Value?.ToString() switch
        {
            "preview" => LwMarkdownViewMode.Preview,
            "split" => LwMarkdownViewMode.Split,
            _ => LwMarkdownViewMode.Edit
        };

        await SetViewMode(mode);
    }

    private async Task SetThemeAsync(ChangeEventArgs args)
    {
        Theme = args.Value?.ToString() == "light" ? "light" : "dark";
        await ThemeChanged.InvokeAsync(Theme);
        StateHasChanged();
        await Task.Delay(50);
        await SafeInvokeVoidAsync("updateOptions", _rootId, _editorId, BuildClientOptions());
    }

    private void ToggleSplitOptions() => _showSplitOptions = !_showSplitOptions;

    private async Task SetSplitOrientation(LwMarkdownSplitOrientation orientation)
    {
        SplitOrientation = orientation;
        _showSplitOptions = false;
        await SplitOrientationChanged.InvokeAsync(orientation);
        StateHasChanged();
        await Task.Delay(50);
        await SafeInvokeVoidAsync("layoutEditor", _editorId);
    }

    private async Task OnSplitOrientationChangedAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<LwMarkdownSplitOrientation>(args.Value?.ToString(), out var orientation))
            await SetSplitOrientation(orientation);
    }

    private void ToggleFullScreen() => FullScreen = !FullScreen;

    private async Task SafeInvokeVoidAsync(string identifier, params object?[] args)
    {
        if (_module is null || _disposed) return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSException or ObjectDisposedException)
        {
            await DisposeModuleAsync();
        }
    }

    private async Task ToolbarClickAsync(LwMarkdownButton button)
    {
        if (CustomButtonClicked.HasDelegate)
            await CustomButtonClicked.InvokeAsync(button);

        if (_module is not null)
            await SafeInvokeVoidAsync("insertToolbarText", _editorId, button.Before ?? string.Empty, button.Placeholder ?? string.Empty, button.After ?? string.Empty);
        else
        {
            var text = BuildInsertion(button);
            if (!string.IsNullOrEmpty(text))
                await InsertTextAsync(text);
        }
    }

    private static string BuildInsertion(LwMarkdownButton button)
    {
        if (!string.IsNullOrEmpty(button.After))
            return $"{button.Before}{button.Placeholder}{button.After}";

        return button.Before ?? string.Empty;
    }

    private static LwMarkdownStats CalculateStats(string value)
    {
        var characters = value.Length;
        var words = string.IsNullOrWhiteSpace(value)
            ? 0
            : value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
        var lines = string.IsNullOrEmpty(value) ? 0 : value.Count(c => c == '\n') + 1;
        var aiTokens = EstimateAiTokens(value);
        return new LwMarkdownStats(characters, words, lines, aiTokens);
    }

    private void ScheduleAutoSave(string? value)
    {
        if (_module is null || string.IsNullOrWhiteSpace(AutoSaveId)) return;

        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;
        var delay = Math.Max(0, AutoSaveDelay);
        var snapshot = value ?? string.Empty;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await SafeInvokeVoidAsync("saveAutoSave", AutoSaveId, snapshot);
                        _lastAutoSaveText = AutoSaveText;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private void ScheduleValueChanged(string? value, string html)
    {
        _valueChangedCts?.Cancel();
        _valueChangedCts?.Dispose();
        _valueChangedCts = new CancellationTokenSource();
        var token = _valueChangedCts.Token;
        var delay = Math.Max(0, AutoSaveDelay);
        var valueSnapshot = value ?? string.Empty;
        var htmlSnapshot = html;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await ValueChanged.InvokeAsync(valueSnapshot);
                        await ValueHTMLChanged.InvokeAsync(htmlSnapshot);
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private static int EstimateAiTokens(string value)
    {
        if (string.IsNullOrEmpty(value)) return 0;

        var tokens = 0;
        var inWord = false;

        foreach (var c in value)
        {
            if (char.IsLetterOrDigit(c) || c == '_')
            {
                if (!inWord)
                {
                    tokens++;
                    inWord = true;
                }
                continue;
            }

            inWord = false;
            if (!char.IsWhiteSpace(c))
                tokens++;
        }

        return tokens;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _valueChangedCts?.Cancel();
        _valueChangedCts?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _editorId);
                await _module.DisposeAsync();
            }
            catch
            {
                // JS runtime may already be gone during circuit disposal.
            }
        }

        _dotNetRef?.Dispose();
    }

    private async Task OnSearchIconClicked(MouseEventArgs args)
        => await ShowFindAsync();

    [JSInvokable]
    public async Task OpenSearchFromJs()
        => await ShowFindAsync();

    private async Task ShowFindAsync()
    {
        if (!EnableSearch) return;
        _findVisible = true;
        await RecalculateFindResultsAsync();
        await SafeInvokeVoidAsync("focusFindInput", _rootId);
    }

    private void HideFind() => _findVisible = false;

    private async Task FindNextAsync()
    {
        if (_findMatches.Count == 0) return;
        _findIndex = (_findIndex + 1) % _findMatches.Count;
        await SelectCurrentFindAsync();
    }

    private async Task FindPreviousAsync()
    {
        if (_findMatches.Count == 0) return;
        _findIndex = _findIndex <= 0 ? _findMatches.Count - 1 : _findIndex - 1;
        await SelectCurrentFindAsync();
    }

    private async Task RecalculateFindResultsAsync()
    {
        _findMatches = [];
        _findIndex = -1;
        if (string.IsNullOrEmpty(_findText)) return;

        try
        {
            foreach (Match match in BuildFindRegex().Matches(Value ?? string.Empty))
                _findMatches.Add(match.Index);
        }
        catch (ArgumentException)
        {
            _findMatches = [];
            _findIndex = -1;
        }
    }

    private Regex BuildFindRegex()
    {
        var pattern = _findRegex ? _findText : Regex.Escape(_findText);
        if (_findWholeWord) pattern = $"\\b{pattern}\\b";
        var options = RegexOptions.Multiline | (_findMatchCase ? RegexOptions.None : RegexOptions.IgnoreCase);
        return new Regex(pattern, options, TimeSpan.FromMilliseconds(200));
    }

    private async Task SelectCurrentFindAsync()
    {
        if (_findIndex < 0 || _findIndex >= _findMatches.Count) return;
        var start = _findMatches[_findIndex];
        var length = BuildFindRegex().Match(Value ?? string.Empty, start).Length;
        await SafeInvokeVoidAsync("selectTextRange", _editorId, start, length);
    }
}
